{% assign has_image = false %}
{% if collection.image %}
  {% assign has_image = true %}
{% endif %}

<div class="collection-banner" style="--banner-height: {{ section.settings.banner_height }}svh;">

  {% if has_image %}
    <div class="collection-banner__image-col">
      <img
        src="{{ collection.image | image_url: width: 1200 }}"
        alt="{{ collection.image.alt | default: collection.title | escape }}"
        loading="eager"
        class="collection-banner__image"
      >
    </div>
  {% endif %}

  <div class="collection-banner__text-col {% unless has_image %}collection-banner__text-col--full{% endunless %}">
    <div class="collection-banner__text-inner">
      <p class="collection-banner__eyebrow">Collection</p>
      <h1 class="collection-banner__title">{{ collection.title }}</h1>
      <div class="collection-banner__accent"></div>
      {% if collection.description != blank %}
        <div class="collection-banner__description rte">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>

</div>

{% stylesheet %}
  .collection-banner {
    display: flex;
    align-items: stretch;
    height: var(--banner-height, 35svh);
    overflow: hidden;
  }

  .collection-banner__image-col {
    flex-shrink: 0;
    overflow: hidden;
    min-width: 30%;
  }

  .collection-banner__image {
    height: 100%;
    width: auto;
    min-width: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .collection-banner__text-col {
    flex: 1;
    background-color: #0f1a26;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 48px;
    overflow-y: auto;
  }

  .collection-banner__text-col--full {
    flex: 1;
  }

  .collection-banner__text-inner {
    max-width: 560px;
    width: 100%;
  }

  .collection-banner__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c2a35d;
    margin-block-end: 8px;
  }

  .collection-banner__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: #ffffff;
    margin-block-end: 12px;
  }

  .collection-banner__accent {
    width: 40px;
    height: 3px;
    background-color: #c2a35d;
    border-radius: 2px;
    margin-block-end: 12px;
  }

  .collection-banner__description,
  .collection-banner__description * {
    font-family: var(--font-body--family) !important;
    font-size: 0.875rem !important;
    font-style: normal !important;
    line-height: 1.6 !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .collection-banner__description {
    color: rgba(255, 255, 255, 0.75);
  }

  @media screen and (max-width: 749px) {
    .collection-banner {
      flex-direction: column;
      height: auto;
    }

    .collection-banner__image-col {
      height: 260px;
    }

    .collection-banner__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .collection-banner__text-col {
      padding: 24px;
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Banner",
  "templates": ["collection"],
  "settings": [
    {
      "type": "range",
      "id": "banner_height",
      "label": "Banner height",
      "min": 25,
      "max": 75,
      "step": 5,
      "unit": "svh",
      "default": 35
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
