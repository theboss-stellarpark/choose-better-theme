{% liquid
  assign design_handle = product.metafields.custom.design_story.value
  if design_handle != blank
    assign article_path = 'our-designs/' | append: design_handle
    assign story = articles[article_path]
  endif
%}

{% if story != blank %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <div
    class="design-story section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
    style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
  >
    <div class="design-story__layout">
      <div class="design-story__text">
        <h2 class="design-story__title">{{ story.title }}</h2>
        <div class="design-story__body rte">{{ story.content }}</div>
      </div>

      {% if story.image %}
        <div class="design-story__image">
          <img
            src="{{ story.image | image_url: width: 800 }}"
            alt="{{ story.image.alt | escape }}"
            width="{{ story.image.width }}"
            height="{{ story.image.height }}"
            loading="lazy"
          >
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .design-story__layout {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 48px;
  }

  .design-story__text {
    flex: 1;
    min-width: 0;
  }

  .design-story__image {
    width: 38%;
    flex-shrink: 0;
  }

  .design-story__image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .design-story__title {
    font-family: var(--font-heading--family);
    margin-block-end: 24px;
  }

  .design-story__body {
    margin-block-end: 32px;
  }

  .design-story__body img {
    max-width: 100%;
    height: auto;
    margin-block: 24px;
  }

  .design-story__link {
    display: inline-block;
    font-family: var(--font-subheading--family);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }

  @media screen and (max-width: 749px) {
    .design-story__layout {
      flex-direction: column;
    }

    .design-story__image {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Design Story",
  "templates": ["product"],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
