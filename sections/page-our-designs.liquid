{% assign design_blog = blogs['our-designs'] %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="our-designs-page section color-{{ section.settings.color_scheme }} spacing-style"
  style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
>
  <header class="our-designs-page__header">
    <h1 class="our-designs-page__title">{{ page.title }}</h1>
    {% if page.content != blank %}
      <div class="our-designs-page__intro rte">{{ page.content }}</div>
    {% endif %}
  </header>

  <div class="our-designs-page__entries">
    {% for article in design_blog.articles %}
      <div class="design-entry {% cycle 'design-entry--default', 'design-entry--reverse' %}">
        <div class="design-entry__text">
          <h2 class="design-entry__title">{{ article.title }}</h2>
          <div class="design-entry__body rte">{{ article.content }}</div>
        </div>
        {% if article.image %}
          <div class="design-entry__image">
            <img
              src="{{ article.image | image_url: width: 900 }}"
              alt="{{ article.image.alt | escape }}"
              loading="lazy"
            >
          </div>
        {% endif %}
      </div>
      {% unless forloop.last %}
        <div class="design-entry__divider"></div>
      {% endunless %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .our-designs-page {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .our-designs-page__header {
    text-align: center;
    margin-block-end: 64px;
  }

  .our-designs-page__title {
    font-family: var(--font-heading--family);
    font-size: 2.5rem;
    margin-block-end: 16px;
  }

  .our-designs-page__intro {
    max-width: 600px;
    margin-inline: auto;
    font-size: 1.125rem;
    line-height: 1.7;
    opacity: 0.85;
  }

  .our-designs-page__entries {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .design-entry {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 56px;
  }

  .design-entry--reverse {
    flex-direction: row-reverse;
  }

  .design-entry__text {
    flex: 1;
    min-width: 0;
  }

  .design-entry__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    margin-block-end: 20px;
  }

  .design-entry__body {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .design-entry__image {
    width: 42%;
    flex-shrink: 0;
  }

  .design-entry__image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
  }

  .design-entry__divider {
    height: 1px;
    background-color: rgb(var(--color-border-rgb) / 0.25);
  }

  @media screen and (max-width: 749px) {
    .design-entry,
    .design-entry--reverse {
      flex-direction: column;
    }

    .design-entry__image {
      width: 100%;
    }

    .our-designs-page__title {
      font-size: 1.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Designs Page",
  "templates": ["page"],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
