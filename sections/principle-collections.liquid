{% liquid
  assign c1 = section.settings.collection_1
  assign c2 = section.settings.collection_2
  assign c3 = section.settings.collection_3
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="principle-collections section section--page-width color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="principle-collections__header">
    <p class="principle-collections__eyebrow">{{ section.settings.heading }}</p>
  </div>

  <div class="principle-collections__grid">

    {% for i in (1..3) %}
      {% liquid
        case i
          when 1
            assign coll = c1
          when 2
            assign coll = c2
          when 3
            assign coll = c3
        endcase
      %}

      {% if coll != blank %}
        <a href="{{ coll.url }}" class="principle-card" aria-label="{{ coll.title }}">
          <div class="principle-card__media">
            {% if coll.image %}
              <img
                src="{{ coll.image | image_url: width: 800 }}"
                alt="{{ coll.image.alt | default: coll.title | escape }}"
                loading="lazy"
                class="principle-card__img"
              >
            {% else %}
              <div class="principle-card__placeholder"></div>
            {% endif %}
          </div>
          <div class="principle-card__overlay"></div>
          <div class="principle-card__content">
            <p class="principle-card__eyebrow">Collection</p>
            <h3 class="principle-card__title">{{ coll.title }}</h3>
            <span class="principle-card__cta">Shop Now <span aria-hidden="true">→</span></span>
          </div>
        </a>
      {% else %}
        <div class="principle-card principle-card--empty">
          <div class="principle-card__content">
            <p class="principle-card__title">Coming Soon</p>
          </div>
        </div>
      {% endif %}

    {% endfor %}

  </div>
</div>

{% stylesheet %}
  .principle-collections__header {
    text-align: center;
    margin-block-end: 32px;
  }

  .principle-collections__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #c2a35d;
    margin: 0;
  }

  .principle-collections__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .principle-card {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 3 / 4;
    text-decoration: none;
    background-color: #0f1a26;
  }

  .principle-card__media {
    position: absolute;
    inset: 0;
  }

  .principle-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s ease;
  }

  .principle-card:hover .principle-card__img {
    transform: scale(1.04);
  }

  .principle-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: #1c2a39;
  }

  .principle-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 26, 38, 0.92) 0%,
      rgba(15, 26, 38, 0.4) 45%,
      rgba(15, 26, 38, 0.0) 100%
    );
  }

  .principle-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .principle-card__eyebrow {
    font-family: var(--font-subheading--family);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c2a35d;
    margin: 0;
  }

  .principle-card__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }

  .principle-card__cta {
    display: inline-block;
    font-family: var(--font-subheading--family);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c2a35d;
    margin-block-start: 4px;
    transition: letter-spacing 0.2s ease;
  }

  .principle-card:hover .principle-card__cta {
    letter-spacing: 0.14em;
  }

  .principle-card--empty {
    display: flex;
    align-items: flex-end;
    padding: 24px 28px;
  }

  @media screen and (max-width: 749px) {
    .principle-collections__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .principle-card {
      aspect-ratio: 4 / 3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Principle Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Principle"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1 (Growth)"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2 (Respect)"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3 (Common Ground)"
    },
    {
      "type": "header",
      "content": "Color & Spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Principle Collections"
    }
  ]
}
{% endschema %}
