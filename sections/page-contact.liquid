{% form 'contact' %}{% endform %}

<div class="contact-page">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <div class="contact-page__inner color-{{ section.settings.color_scheme }} spacing-style"
    style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
  >
    <header class="contact-page__header">
      <h1 class="contact-page__title">{{ page.title }}</h1>
      <div class="contact-page__accent"></div>
      {% if page.content != blank %}
        <div class="contact-page__intro rte">{{ page.content }}</div>
      {% else %}
        <p class="contact-page__intro">Have a question or just want to say hello? We'd love to hear from you.</p>
      {% endif %}
    </header>

    <div class="contact-page__card">
      {% form 'contact', id: 'ContactForm' %}
        {% if form.posted_successfully? %}
          <p class="contact-page__success">Thanks for reaching out — we'll get back to you shortly.</p>
        {% endif %}

        {% if form.errors %}
          <div class="contact-page__errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="contact-page__fields">
          <div class="contact-field">
            <label class="contact-field__label" for="ContactForm-name">Name</label>
            <input
              class="contact-field__input"
              type="text"
              id="ContactForm-name"
              name="contact[name]"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Your name"
            >
          </div>

          <div class="contact-field">
            <label class="contact-field__label" for="ContactForm-email">Email</label>
            <input
              class="contact-field__input"
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="your@email.com"
              required
            >
          </div>

          <div class="contact-field contact-field--full">
            <label class="contact-field__label" for="ContactForm-body">Message</label>
            <textarea
              class="contact-field__input contact-field__textarea"
              id="ContactForm-body"
              name="contact[body]"
              rows="6"
              placeholder="What's on your mind?"
            >{{ form.body }}</textarea>
          </div>
        </div>

        <div class="contact-page__submit">
          <button type="submit" class="button">Send Message</button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% stylesheet %}
  .contact-page {
    position: relative;
  }

  .contact-page__inner {
    max-width: 680px;
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
  }

  .contact-page__header {
    text-align: center;
    margin-block-end: 40px;
  }

  .contact-page__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-h1--size, 2.5rem);
    margin-block-end: 16px;
  }

  .contact-page__accent {
    width: 48px;
    height: 3px;
    background-color: #c2a35d;
    margin-inline: auto;
    margin-block-end: 20px;
    border-radius: 2px;
  }

  .contact-page__intro {
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    line-height: 1.7;
    opacity: 0.8;
    margin: 0;
  }

  .contact-page__card {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 48px;
    box-shadow: 0 4px 24px rgba(15, 26, 38, 0.08);
  }

  .contact-page__success {
    background-color: #f3efe7;
    border-left: 3px solid #c2a35d;
    border-radius: 4px;
    padding: 16px 20px;
    font-family: var(--font-subheading--family);
    font-size: 0.9375rem;
    margin-block-end: 24px;
  }

  .contact-page__errors {
    background-color: #fff0f0;
    border-left: 3px solid #c0392b;
    border-radius: 4px;
    padding: 16px 20px;
    margin-block-end: 24px;
    font-size: 0.875rem;
  }

  .contact-page__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-block-end: 24px;
  }

  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact-field--full {
    grid-column: 1 / -1;
  }

  .contact-field__label {
    font-family: var(--font-subheading--family);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #1c2a39;
  }

  .contact-field__input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #d8d2c8;
    border-radius: 8px;
    font-family: var(--font-body--family);
    font-size: 1rem;
    color: #1c2a39;
    background-color: #faf8f5;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  .contact-field__input:focus {
    outline: none;
    border-color: #c2a35d;
    box-shadow: 0 0 0 3px rgba(194, 163, 93, 0.15);
    background-color: #ffffff;
  }

  .contact-field__textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact-page__submit {
    display: flex;
    justify-content: flex-end;
  }

  @media screen and (max-width: 749px) {
    .contact-page__card {
      padding: 28px 24px;
    }

    .contact-page__fields {
      grid-template-columns: 1fr;
    }

    .contact-field--full {
      grid-column: 1;
    }

    .contact-page__submit {
      justify-content: stretch;
    }

    .contact-page__submit .button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact Page",
  "templates": ["page"],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
