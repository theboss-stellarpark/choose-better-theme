<div class="faq-page">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>

  <div class="faq-page__inner color-{{ section.settings.color_scheme }} spacing-style"
    style="--padding-block-start: {{ section.settings['padding-block-start'] }}px; --padding-block-end: {{ section.settings['padding-block-end'] }}px;"
  >
    <header class="faq-page__header">
      <h1 class="faq-page__title">{{ page.title }}</h1>
      <div class="faq-page__accent"></div>
      <p class="faq-page__intro">Everything you need to know. Can't find an answer? <a href="/pages/contact" class="faq-page__contact-link">Reach out to us.</a></p>
    </header>

    <div class="faq-page__card">
      <div class="faq-page__content rte">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .faq-page {
    position: relative;
  }

  .faq-page__inner {
    max-width: 760px;
    margin-inline: auto;
    padding-inline: var(--page-margin, 24px);
  }

  .faq-page__header {
    text-align: center;
    margin-block-end: 40px;
  }

  .faq-page__title {
    font-family: var(--font-heading--family);
    font-size: var(--font-h1--size, 2.5rem);
    margin-block-end: 16px;
  }

  .faq-page__accent {
    width: 48px;
    height: 3px;
    background-color: #c2a35d;
    margin-inline: auto;
    margin-block-end: 20px;
    border-radius: 2px;
  }

  .faq-page__intro {
    font-family: var(--font-body--family);
    font-size: 1.0625rem;
    line-height: 1.7;
    opacity: 0.8;
    margin: 0;
  }

  .faq-page__contact-link {
    color: #c2a35d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-page__card {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 48px;
    box-shadow: 0 4px 24px rgba(15, 26, 38, 0.08);
  }

  /* FAQ question styling — targets h2 and h3 in page content */
  .faq-page__content h2,
  .faq-page__content h3 {
    font-family: var(--font-subheading--family);
    font-size: 1.0625rem;
    font-weight: 600;
    color: #1c2a39;
    padding-block: 20px;
    padding-inline-start: 16px;
    border-left: 3px solid #c2a35d;
    margin-block-start: 32px;
    margin-block-end: 12px;
    line-height: 1.4;
  }

  .faq-page__content h2:first-child,
  .faq-page__content h3:first-child {
    margin-block-start: 0;
    padding-block-start: 0;
  }

  /* Answer paragraph styling */
  .faq-page__content p {
    font-family: var(--font-body--family);
    font-size: 1rem;
    line-height: 1.75;
    color: #1c2a39;
    opacity: 0.85;
    margin-block-end: 0;
  }

  /* Divider between Q&A pairs */
  .faq-page__content h2 + p + h2,
  .faq-page__content h2 + p + h3,
  .faq-page__content h3 + p + h2,
  .faq-page__content h3 + p + h3 {
    border-top: 1px solid rgba(15, 26, 38, 0.1);
  }

  /* Links inside answers */
  .faq-page__content a {
    color: #c2a35d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .faq-page__card {
      padding: 28px 24px;
    }

    .faq-page__title {
      font-size: 1.75rem;
    }

    .faq-page__content h2,
    .faq-page__content h3 {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ Page",
  "templates": ["page"],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
