{% comment %}
  Renders a size chart accordion based on a product tag matching "size-chart:[key]".
  Chart HTML is stored in the blank_content metaobject under the field "size_chart_html".
  To add a new product type: create a blank_content entry with the matching handle and
  populate size_chart_html — no code changes needed here.
  Usage: {% render 'size-chart', product: product %}
{% endcomment %}

{% assign size_chart_key = '' %}
{% for tag in product.tags %}
  {% if tag contains 'size-chart:' %}
    {% assign size_chart_key = tag | remove: 'size-chart:' %}
    {% break %}
  {% endif %}
{% endfor %}

{% if size_chart_key != blank %}
  {% assign blank_obj   = shop.metaobjects.blank_content[size_chart_key] %}
  {% assign chart_html  = blank_obj.size_chart_html.value %}

  {% if chart_html != blank %}
    {% capture accordion_children %}
      <details class="details" data-testid="accordion-details">
        <summary class="details__header">
          Size Chart
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="details-content">
          {{ chart_html }}
        </div>
      </details>
    {% endcapture %}

    <div class="accordion accordion--icon-none border-style spacing-style">
      {% render 'accordion-custom-component',
        children: accordion_children,
        open_by_default_on_desktop: false,
        open_by_default_on_mobile: false
      %}
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
  .size-chart__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .size-chart__table th,
  .size-chart__table td {
    padding: 8px 12px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .size-chart__table thead th {
    font-family: var(--font-subheading--family);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.75rem;
    background-color: var(--color-background-2);
  }

  .size-chart__table tbody td:first-child {
    font-family: var(--font-subheading--family);
    font-weight: 600;
  }

  .size-chart__table tbody tr:nth-child(even) {
    background-color: var(--color-background-2);
  }
{% endstylesheet %}
