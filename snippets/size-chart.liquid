{% comment %}
  Renders a size chart accordion based on a product tag matching "details_[key]".
  Falls back to the legacy "size-chart:[key]" tag for products tagged before the
  2026-09-17 rename — no need to retag existing products.
  The chart HTML comes from the "details_content" metaobject entry whose handle
  matches the key — edit or add entries there to change or add charts, no
  theme code changes needed.
  Outputs nothing if no matching tag or metaobject entry exists.
  Usage: {% render 'size-chart', product: product %}
{% endcomment %}

{% assign size_chart_key = '' %}
{% for tag in product.tags %}
  {% if tag contains 'details_' %}
    {% assign size_chart_key = tag | remove: 'details_' %}
    {% break %}
  {% endif %}
{% endfor %}

{% if size_chart_key == blank %}
  {% for tag in product.tags %}
    {% if tag contains 'size-chart:' %}
      {% assign size_chart_key = tag | remove: 'size-chart:' %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if size_chart_key != blank %}
  {% assign details_entry = metaobjects['details_content'][size_chart_key] %}
  {% assign size_chart_table = details_entry.size_chart_html.value %}

  {% if size_chart_table != blank %}
    {% capture accordion_children %}
      <details class="details" data-testid="accordion-details">
        <summary class="details__header">
          Size Chart
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="details-content">
          {{ size_chart_table }}
        </div>
      </details>
    {% endcapture %}

    <div class="accordion accordion--icon-none border-style spacing-style">
      {% render 'accordion-custom-component',
        children: accordion_children,
        open_by_default_on_desktop: false,
        open_by_default_on_mobile: false
      %}
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
  .size-chart__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .size-chart__table th,
  .size-chart__table td {
    padding: 8px 12px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .size-chart__table thead th {
    font-family: var(--font-subheading--family);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.75rem;
    background-color: var(--color-background-2);
  }

  .size-chart__table tbody td:first-child {
    font-family: var(--font-subheading--family);
    font-weight: 600;
  }

  .size-chart__table tbody tr:nth-child(even) {
    background-color: var(--color-background-2);
  }
{% endstylesheet %}
