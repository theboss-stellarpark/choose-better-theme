{% comment %}
  Renders a size chart accordion based on a product tag matching "size-chart:[key]".
  Outputs nothing if no matching tag exists.
  Usage: {% render 'size-chart', product: product %}
  To add a new chart: add a {% when '[key]' %} block and tag products "size-chart:[key]".
{% endcomment %}

{% assign size_chart_key = '' %}
{% for tag in product.tags %}
  {% if tag contains 'size-chart:' %}
    {% assign size_chart_key = tag | remove: 'size-chart:' %}
    {% break %}
  {% endif %}
{% endfor %}

{% if size_chart_key != blank %}
  {% capture size_chart_table %}
    {% case size_chart_key %}

      {% when 'premium-hoodie' %}
        <table class="size-chart__table">
          <thead>
            <tr>
              <th></th>
              <th>LENGTH (in)</th>
              <th>WIDTH (in)</th>
              <th>SLEEVE LENGTH (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>28</td><td>20</td><td>34 ½</td></tr>
            <tr><td>M</td><td>29</td><td>22</td><td>35 ½</td></tr>
            <tr><td>L</td><td>30</td><td>24</td><td>36 ½</td></tr>
            <tr><td>XL</td><td>31</td><td>26</td><td>37 ½</td></tr>
            <tr><td>2XL</td><td>32</td><td>27</td><td>38 ½</td></tr>
          </tbody>
        </table>

      {% when 'premium-tshirt' %}
        <table class="size-chart__table">
          <thead>
            <tr>
              <th></th>
              <th>LENGTH (in)</th>
              <th>WIDTH (in)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>S</td><td>28</td><td>18 ½</td></tr>
            <tr><td>M</td><td>29 ½</td><td>20 ½</td></tr>
            <tr><td>L</td><td>31</td><td>22 ¼</td></tr>
            <tr><td>XL</td><td>31 ¼</td><td>24</td></tr>
            <tr><td>2XL</td><td>33</td><td>25 ¼</td></tr>
            <tr><td>3XL</td><td>33 ½</td><td>26 ¾</td></tr>
          </tbody>
        </table>

      {% when 'quarter-zip' %}
        <table class="size-chart__table">
          <thead>
            <tr>
              <th></th>
              <th>LENGTH (inches)</th>
              <th>CHEST (inches)</th>
              <th>SLEEVE LENGTH (inches)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>XS</td><td>27</td><td>19</td><td>34 ¼</td></tr>
            <tr><td>S</td><td>28</td><td>20 ½</td><td>35</td></tr>
            <tr><td>M</td><td>29</td><td>22</td><td>35 ¾</td></tr>
            <tr><td>L</td><td>30</td><td>23 ½</td><td>36 ½</td></tr>
            <tr><td>XL</td><td>31</td><td>25</td><td>37 ¼</td></tr>
            <tr><td>2XL</td><td>32</td><td>26 ½</td><td>38</td></tr>
            <tr><td>3XL</td><td>32 ½</td><td>28 ½</td><td>38 ¾</td></tr>
            <tr><td>4XL</td><td>33</td><td>30 ½</td><td>39 ½</td></tr>
          </tbody>
        </table>

      {% when 'long-sleeve' %}
        <table class="size-chart__table">
          <thead>
            <tr>
              <th></th>
              <th>SHIRT LENGTH (inches)</th>
              <th>CHEST WIDTH (inches)</th>
              <th>CHEST TO FIT (inches)</th>
              <th>SLEEVE LENGTH (inches)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>XS</td><td>27</td><td>16 ½</td><td>31-34</td><td>25</td></tr>
            <tr><td>S</td><td>28</td><td>18</td><td>34-37</td><td>25 ⅝</td></tr>
            <tr><td>M</td><td>29</td><td>20</td><td>38-41</td><td>26 ¼</td></tr>
            <tr><td>L</td><td>30</td><td>22</td><td>42-45</td><td>26 ⅞</td></tr>
            <tr><td>XL</td><td>31</td><td>24</td><td>46-49</td><td>27 ½</td></tr>
            <tr><td>2XL</td><td>32</td><td>26</td><td>50-53</td><td>28 ⅛</td></tr>
          </tbody>
        </table>

      {% when 'unstructured-hat' %}
        <table class="size-chart__table">
          <thead>
            <tr>
              <th></th>
              <th>A (inches)</th>
              <th>B (inches)</th>
              <th>C (inches)</th>
              <th>D (inches)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>One size</td><td>20 ½-24 ⅜</td><td>4 ¾</td><td>3 ⅛</td><td>7 ½</td></tr>
          </tbody>
        </table>

    {% endcase %}
  {% endcapture %}

  {% if size_chart_table != blank %}
    {% capture accordion_children %}
      <details class="details" data-testid="accordion-details">
        <summary class="details__header">
          Size Chart
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </summary>
        <div class="details-content">
          {{ size_chart_table }}
        </div>
      </details>
    {% endcapture %}

    <div class="accordion accordion--icon-none border-style spacing-style">
      {% render 'accordion-custom-component',
        children: accordion_children,
        open_by_default_on_desktop: false,
        open_by_default_on_mobile: false
      %}
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
  .size-chart__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .size-chart__table th,
  .size-chart__table td {
    padding: 8px 12px;
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .size-chart__table thead th {
    font-family: var(--font-subheading--family);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.75rem;
    background-color: var(--color-background-2);
  }

  .size-chart__table tbody td:first-child {
    font-family: var(--font-subheading--family);
    font-weight: 600;
  }

  .size-chart__table tbody tr:nth-child(even) {
    background-color: var(--color-background-2);
  }
{% endstylesheet %}
